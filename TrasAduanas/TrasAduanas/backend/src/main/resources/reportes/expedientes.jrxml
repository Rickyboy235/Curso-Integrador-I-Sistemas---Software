<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="expedientes"
        pageWidth="842"
        pageHeight="595"
        orientation="Landscape"
        columnWidth="802"
        leftMargin="20"
        rightMargin="20"
        topMargin="30"
        bottomMargin="30"
        whenNoDataType="AllSectionsNoDetail">

    <field name="numeroOrden" class="java.lang.String"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="numeroDam" class="java.lang.String"/>
    <field name="regimen" class="java.lang.String"/>
    <field name="canalControl" class="java.lang.String"/>
    <field name="estadoTramite" class="java.lang.String"/>

    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="802" height="30"/>
                <textElement textAlignment="Center">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[REPORTE DE EXPEDIENTES DAM]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="33" width="802" height="12"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Control documentario y aduanero - Auditoría]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="47" width="802" height="13"/>
                <textElement textAlignment="Center">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm")
                    .format(new java.util.Date())
                ]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText>
                <reportElement x="0" y="0" width="120" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[N° orden]]></text>
            </staticText>
            <staticText>
                <reportElement x="120" y="0" width="200" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Cliente]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="0" width="140" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[N° DAM]]></text>
            </staticText>
            <staticText>
                <reportElement x="460" y="0" width="140" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Régimen]]></text>
            </staticText>
            <staticText>
                <reportElement x="600" y="0" width="100" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Canal SUNAT]]></text>
            </staticText>
            <staticText>
                <reportElement x="700" y="0" width="102" height="22"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Estado del trámite]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="120" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{numeroOrden}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="120" y="0" width="200" height="20"/>
                <box leftPadding="6" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{cliente}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="0" width="140" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{numeroDam}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="460" y="0" width="140" height="20"/>
                <box leftPadding="6" rightPadding="4"><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{regimen}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="600" y="0" width="100" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{canalControl}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="700" y="0" width="102" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{estadoTramite}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="25">
            <staticText>
                <reportElement x="0" y="5" width="670" height="15"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <text><![CDATA[TransAduanas - Reporte de Auditoría (Expedientes DAM)]]></text>
            </staticText>
            <textField>
                <reportElement x="670" y="5" width="132" height="15"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Página " + $V{PAGE_NUMBER}
                ]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <noData>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="802" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="11" isItalic="true"/>
                </textElement>
                <text><![CDATA[No hay expedientes DAM registrados.]]></text>
            </staticText>
        </band>
    </noData>

</jasperReport>