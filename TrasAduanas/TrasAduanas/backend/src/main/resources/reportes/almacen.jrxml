<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="almacen"
        pageWidth="595"
        pageHeight="842"
        columnWidth="535"
        leftMargin="30"
        rightMargin="30"
        topMargin="30"
        bottomMargin="30"
        uuid="7b7e4d91-8d8d-4e77-9c7a-8c2f7e4d9123">

    <parameter name="tituloReporte" class="java.lang.String"/>

    <!-- CAMPOS -->

    <field name="codigo" class="java.lang.String"/>
    <field name="descripcion" class="java.lang.String"/>
    <field name="stockActual" class="java.math.BigDecimal"/>
    <field name="stockMinimo" class="java.math.BigDecimal"/>
    <field name="estado" class="java.lang.String"/>

    <!-- TÍTULO -->

    <title>
        <band height="80">

            <staticText>
                <reportElement
                        x="0"
                        y="0"
                        width="535"
                        height="30"
                        uuid="11111111-1111-1111-1111-111111111111"/>

                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>

                <text><![CDATA[REPORTE DE ALMACÉN]]></text>
            </staticText>

            <textField>
                <reportElement
                        x="0"
                        y="35"
                        width="535"
                        height="20"
                        uuid="22222222-2222-2222-2222-222222222222"/>

                <textElement textAlignment="Center">
                    <font size="12"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[$P{tituloReporte}]]>
                </textFieldExpression>
            </textField>

            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement
                        x="0"
                        y="58"
                        width="535"
                        height="15"
                        uuid="33333333-3333-3333-3333-333333333333"/>

                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA[new java.util.Date()]]>
                </textFieldExpression>
            </textField>

        </band>
    </title>

    <!-- ENCABEZADO DE TABLA -->

    <columnHeader>
        <band height="30">

            <staticText>
                <reportElement
                        x="0"
                        y="0"
                        width="90"
                        height="30"
                        uuid="44444444-4444-4444-4444-444444444444"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[CÓDIGO]]></text>
            </staticText>

            <staticText>
                <reportElement
                        x="90"
                        y="0"
                        width="210"
                        height="30"
                        uuid="55555555-5555-5555-5555-555555555555"/>

                <box leftPadding="6">
                    <pen lineWidth="0.5"/>
                </box>

                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[DESCRIPCIÓN]]></text>
            </staticText>

            <staticText>
                <reportElement
                        x="300"
                        y="0"
                        width="75"
                        height="30"
                        uuid="66666666-6666-6666-6666-666666666666"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[STOCK ACTUAL]]></text>
            </staticText>

            <staticText>
                <reportElement
                        x="375"
                        y="0"
                        width="75"
                        height="30"
                        uuid="77777777-7777-7777-7777-777777777777"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[STOCK MÍN.]]></text>
            </staticText>

            <staticText>
                <reportElement
                        x="450"
                        y="0"
                        width="85"
                        height="30"
                        uuid="88888888-8888-8888-8888-888888888888"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[ESTADO]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- DETALLE -->

    <detail>
        <band height="30">

            <textField>
                <reportElement
                        x="0"
                        y="0"
                        width="90"
                        height="30"
                        uuid="99999999-9999-9999-9999-999999999999"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle"/>

                <textFieldExpression>
                    <![CDATA[$F{codigo}]]>
                </textFieldExpression>
            </textField>

            <textField>
                <reportElement x="90" y="0" width="210" height="30" uuid="aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"/>
                <box leftPadding="6">
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <textFieldExpression>
                    <![CDATA[$F{descripcion}]]>
                </textFieldExpression>
            </textField>

            <textField>
                <reportElement
                        x="300"
                        y="0"
                        width="75"
                        height="30"
                        uuid="bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle"/>

                <textFieldExpression>
                    <![CDATA[$F{stockActual}]]>
                </textFieldExpression>
            </textField>

            <textField>
                <reportElement
                        x="375"
                        y="0"
                        width="75"
                        height="30"
                        uuid="cccccccc-cccc-cccc-cccc-cccccccccccc"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle"/>

                <textFieldExpression>
                    <![CDATA[$F{stockMinimo}]]>
                </textFieldExpression>
            </textField>

            <textField>
                <reportElement
                        x="450"
                        y="0"
                        width="85"
                        height="30"
                        uuid="dddddddd-dddd-dddd-dddd-dddddddddddd"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle"/>

                <textFieldExpression>
                    <![CDATA[$F{estado}]]>
                </textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- PIE DE PÁGINA -->

    <pageFooter>
        <band height="30">

            <textField>
                <reportElement
                        x="435"
                        y="5"
                        width="100"
                        height="20"
                        uuid="eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee"/>

                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>

                <textFieldExpression>
                    <![CDATA["Página " + $V{PAGE_NUMBER}]]>
                </textFieldExpression>
            </textField>

        </band>
    </pageFooter>

</jasperReport>