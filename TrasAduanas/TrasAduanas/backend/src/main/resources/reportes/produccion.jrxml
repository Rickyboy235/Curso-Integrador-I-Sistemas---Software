<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="produccion"
        pageWidth="842"
        pageHeight="595"
        columnWidth="782"
        leftMargin="30"
        rightMargin="30"
        topMargin="30"
        bottomMargin="30">
    
    <!-- CAMPOS -->

    <field name="numeroVale" class="java.lang.String"/>
    <field name="numeroOrden" class="java.lang.String"/>
    <field name="fechaEmision" class="java.time.LocalDate"/>
    <field name="codigoInsumo" class="java.lang.String"/>
    <field name="descripcionInsumo" class="java.lang.String"/>
    <field name="cantidad" class="java.math.BigDecimal"/>

    <title>
        <band height="75">

            <staticText>
                <reportElement
                        x="0"
                        y="0"
                        width="782"
                        height="30"/>
                <textElement textAlignment="Center">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[REPORTE DE PRODUCCIÓN]]></text>
            </staticText>

            <staticText>
                <reportElement
                        x="0"
                        y="35"
                        width="782"
                        height="20"/>
                <textElement textAlignment="Center">
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Vales de salida de producción]]></text>
            </staticText>

            <textField>
                <reportElement
                        x="0"
                        y="57"
                        width="782"
                        height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm")
                    .format(new java.util.Date())
                ]]></textFieldExpression>
            </textField>

        </band>
    </title>

<!-- ENCABEZADO DE TABLA -->

    <columnHeader>
        <band height="30">

            <staticText>
                <reportElement
                        x="0"
                        y="0"
                        width="100"
                        height="30"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[N° Vale]]></text>
            </staticText>

            <staticText>
                <reportElement
                        x="100"
                        y="0"
                        width="100"
                        height="30"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[N° Orden]]></text>
            </staticText>

            <staticText>
                <reportElement
                        x="200"
                        y="0"
                        width="100"
                        height="30"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Fecha]]></text>
            </staticText>

            <staticText>
                <reportElement
                        x="300"
                        y="0"
                        width="100"
                        height="30"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Código]]></text>
            </staticText>

            <staticText>
                <reportElement
                        x="400"
                        y="0"
                        width="282"
                        height="30"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Insumo]]></text>
            </staticText>

            <staticText>
                <reportElement
                        x="682"
                        y="0"
                        width="100"
                        height="30"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Cantidad]]></text>
            </staticText>

        </band>
    </columnHeader>

    <detail>
        <band height="30">

            <textField>
                <reportElement
                        x="0"
                        y="0"
                        width="100"
                        height="30"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{numeroVale}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement
                        x="100"
                        y="0"
                        width="100"
                        height="30"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{numeroOrden}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement
                        x="200"
                        y="0"
                        width="100"
                        height="30"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    $F{fechaEmision} != null
                    ? $F{fechaEmision}.format(
                        java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy")
                    )
                    : ""
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement
                        x="300"
                        y="0"
                        width="100"
                        height="30"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{codigoInsumo}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement
                        x="400"
                        y="0"
                        width="282"
                        height="30"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{descripcionInsumo}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement
                        x="682"
                        y="0"
                        width="100"
                        height="30"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    $F{cantidad}
                ]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <pageFooter>
        <band height="25">

            <staticText>
                <reportElement
                        x="0"
                        y="5"
                        width="650"
                        height="15"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <text><![CDATA[TransAduanas - Reporte de Producción]]></text>
            </staticText>

            <textField>
                <reportElement
                        x="650"
                        y="5"
                        width="132"
                        height="15"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Página " + $V{PAGE_NUMBER}
                ]]></textFieldExpression>
            </textField>

        </band>
    </pageFooter>

</jasperReport>